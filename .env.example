PORT=4007
# The APIs, never another BFF (MAIR-525).
CORE_API_URL=http://localhost:3000
PROJECT_API_URL=http://localhost:3001
CALENDAR_API_URL=http://localhost:3002
# Secret of the session tokens, the same as the upstream services': required, the BFF verifies the
# tokens with it (bffs-lib requireSession) and refuses to start without it.
JWT_SECRET=
# Express trust proxy behind the ingress (true, hop count or addresses); unset = no proxy trusted.
# TRUST_PROXY=1
# OpenTelemetry collector (MAIR-504): unset = telemetry off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
