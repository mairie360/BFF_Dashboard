PORT=4007
# The APIs, never another BFF (MAIR-525).
CORE_API_URL=http://localhost:3000
PROJECT_API_URL=http://localhost:3001
CALENDAR_API_URL=http://localhost:3002
# Core's Ed25519 public key (PEM, `\n` escapes allowed): the BFF verifies the session tokens Core signs
# with it (EdDSA, bffs-lib requireSession, MAIR-680) and refuses to start without a key.
JWT_PUBLIC_KEY=
# HS256 transition only: the upstreams' former shared secret, accepted while it is set. Leave it empty.
JWT_SECRET=
# Express trust proxy behind the ingress (true, hop count or addresses); unset = no proxy trusted.
# TRUST_PROXY=1
# OpenTelemetry collector (MAIR-504): unset = telemetry off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
