{
  "openapi": "3.1.0",
  "info": {
    "title": "bff_dashboard",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "BAD_REQUEST",
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "CONFLICT",
                  "PAYLOAD_TOO_LARGE",
                  "UNPROCESSABLE_ENTITY",
                  "TOO_MANY_REQUESTS",
                  "INTERNAL_ERROR",
                  "BAD_GATEWAY",
                  "SERVICE_UNAVAILABLE",
                  "GATEWAY_TIMEOUT"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "CheckApisResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "OK",
              "Error"
            ]
          },
          "core_api": {
            "type": "string",
            "enum": [
              "Connected",
              "Unreachable"
            ]
          },
          "project_api": {
            "type": "string",
            "enum": [
              "Connected",
              "Unreachable"
            ]
          },
          "calendar_api": {
            "type": "string",
            "enum": [
              "Connected",
              "Unreachable"
            ]
          }
        },
        "required": [
          "status",
          "core_api",
          "project_api",
          "calendar_api"
        ]
      },
      "GlobalSearchResponse": {
        "type": "object",
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "module": {
                  "type": "string",
                  "enum": [
                    "agents",
                    "projects",
                    "calendar",
                    "messages",
                    "elearning"
                  ]
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "agent",
                          "project",
                          "task",
                          "event",
                          "conversation",
                          "message",
                          "course"
                        ]
                      },
                      "id": {
                        "type": "integer"
                      },
                      "title": {
                        "type": "string"
                      },
                      "excerpt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "parent_id": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "updated_at": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "id",
                      "title",
                      "excerpt",
                      "parent_id",
                      "updated_at"
                    ]
                  }
                }
              },
              "required": [
                "module",
                "items"
              ]
            }
          },
          "unavailable": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "agents",
                "projects",
                "calendar",
                "messages",
                "elearning"
              ]
            }
          }
        },
        "required": [
          "groups",
          "unavailable"
        ]
      },
      "DashboardBootstrap": {
        "type": "object",
        "properties": {
          "userFirstName": {
            "type": "string"
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "progress": {
                  "type": "number"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "todo",
                    "in-progress",
                    "review",
                    "done"
                  ]
                },
                "dueDate": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "progress",
                "status",
                "dueDate"
              ]
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "dueDate": {
                  "type": "string"
                },
                "priority": {
                  "type": "string",
                  "enum": [
                    "high",
                    "medium",
                    "low"
                  ]
                },
                "completed": {
                  "type": "boolean"
                },
                "projectId": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "dueDate",
                "priority",
                "completed",
                "projectId"
              ]
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ]
                },
                "title": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "startTime": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "date"
              ]
            }
          },
          "metrics": {
            "type": "object",
            "properties": {
              "totalProjects": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "eventsThisMonth": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "description": "Occurrences of the user's events starting during `eventsPeriod` (recurring events expanded), like the month view of the calendar; null when Calendar API is unavailable"
              },
              "eventsPeriod": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "description": "First day of the current Europe/Paris calendar month (YYYY-MM-DD)"
                  },
                  "to": {
                    "type": "string",
                    "description": "Last day of the current Europe/Paris calendar month (YYYY-MM-DD)"
                  }
                },
                "required": [
                  "from",
                  "to"
                ],
                "description": "Period counted by `eventsThisMonth`"
              }
            },
            "required": [
              "totalProjects",
              "eventsThisMonth",
              "eventsPeriod"
            ]
          },
          "sources": {
            "type": "object",
            "properties": {
              "projects": {
                "type": "string",
                "enum": [
                  "available",
                  "unavailable"
                ]
              },
              "tasks": {
                "type": "string",
                "enum": [
                  "available",
                  "unavailable"
                ]
              },
              "calendar": {
                "type": "string",
                "enum": [
                  "available",
                  "unavailable"
                ]
              },
              "trainings": {
                "type": "string",
                "enum": [
                  "available",
                  "unavailable"
                ]
              },
              "messages": {
                "type": "string",
                "enum": [
                  "available",
                  "unavailable"
                ]
              }
            },
            "required": [
              "projects",
              "tasks",
              "calendar",
              "trainings",
              "messages"
            ]
          },
          "userLastName": {
            "type": "string",
            "description": "Last name from Core API (empty string when it has none)"
          },
          "userRole": {
            "type": [
              "string",
              "null"
            ],
            "description": "Role of the user: Core's profile, else the `role` claim of the token; null when neither has one"
          },
          "communeName": {
            "type": [
              "string",
              "null"
            ],
            "description": "Name of the municipality of the instance (`MAIRIE_NAME`), null when not configured"
          },
          "trainings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "todo",
                    "in-progress",
                    "done"
                  ]
                },
                "completedModules": {
                  "type": "integer"
                },
                "totalModules": {
                  "type": "integer"
                },
                "progress": {
                  "type": "number"
                },
                "dueDate": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Date the training should be completed by (YYYY-MM-DD), null when it has none"
                }
              },
              "required": [
                "id",
                "title",
                "status",
                "completedModules",
                "totalModules",
                "progress",
                "dueDate"
              ]
            },
            "description": "The first 3 trainings of the user from ELearning API: unfinished first (in progress, then to do), then done; soonest due date first inside each group, none last"
          },
          "unreadMessages": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Unread messages of the user over their chats (Message API), for the Messagerie badge; null when Message API is unavailable (`sources.messages`)"
          },
          "onboardingCompleted": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the user finished or skipped the welcome tour (Core API preferences): false shows the tour, true never again; null when Core API could not tell (show nothing)"
          }
        },
        "required": [
          "userFirstName",
          "projects",
          "tasks",
          "events",
          "metrics",
          "sources",
          "userLastName",
          "userRole",
          "communeName",
          "trainings",
          "unreadMessages",
          "onboardingCompleted"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "tags": [
          "Connectivity"
        ],
        "summary": "Checks that the BFF process is up",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/check_apis": {
      "get": {
        "security": [],
        "tags": [
          "Connectivity"
        ],
        "summary": "Checks that the three upstream APIs are reachable",
        "responses": {
          "200": {
            "description": "Every upstream API answered its /health operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckApisResponse"
                }
              }
            }
          },
          "502": {
            "description": "At least one upstream API is unreachable or not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckApisResponse"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Search every module",
        "description": "Searches the agents, projects and tasks, events, conversations and messages, and courses the caller may see, through the business APIs. A module whose API cannot answer is listed in `unavailable`.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Searched text, 2 to 100 characters once trimmed, without control characters",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100,
              "example": "dupont"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Most results per module (default 8)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "example": 8
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Results grouped by module, and the modules that could not answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GlobalSearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid `q` or `limit`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "JWT_PUBLIC_KEY is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/bootstrap": {
      "get": {
        "summary": "Load the dashboard of the signed-in user",
        "responses": {
          "200": {
            "description": "Data read from Core API, Project API, Calendar API, ELearning API and Message API in one parallel wave, within the session scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardBootstrap"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session, or session refused by an upstream API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Core API rate limit reached: retry after the Retry-After header (seconds)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "User profile unavailable: Core API unreachable, failed or answered an invalid body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "An upstream API is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/onboarding": {
      "put": {
        "summary": "Mark the welcome tour as done",
        "description": "Records in Core API that the signed-in user finished or skipped the welcome tour, so `/dashboard/bootstrap` answers `onboardingCompleted: true` from then on. No body; idempotent.",
        "responses": {
          "204": {
            "description": "Recorded (also when it already was)"
          },
          "401": {
            "description": "Missing or invalid session, or session refused by Core API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Core API rate limit reached: retry after the Retry-After header (seconds)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Core API unreachable, failed or answered an invalid body: nothing is recorded, the tour shows again next time",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Core API is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
