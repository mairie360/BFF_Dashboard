{
  "openapi": "3.1.0",
  "info": {
    "title": "bff_dashboard",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "BAD_REQUEST",
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "CONFLICT",
                  "PAYLOAD_TOO_LARGE",
                  "UNPROCESSABLE_ENTITY",
                  "TOO_MANY_REQUESTS",
                  "INTERNAL_ERROR",
                  "BAD_GATEWAY",
                  "SERVICE_UNAVAILABLE",
                  "GATEWAY_TIMEOUT"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "CheckApisResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "OK",
              "Error"
            ]
          },
          "user_bff": {
            "type": "string",
            "enum": [
              "Connected",
              "Unreachable"
            ]
          },
          "project_bff": {
            "type": "string",
            "enum": [
              "Connected",
              "Unreachable"
            ]
          },
          "calendar_bff": {
            "type": "string",
            "enum": [
              "Connected",
              "Unreachable"
            ]
          }
        },
        "required": [
          "status",
          "user_bff",
          "project_bff",
          "calendar_bff"
        ]
      },
      "DashboardBootstrap": {
        "type": "object",
        "properties": {
          "userFirstName": {
            "type": "string"
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "progress": {
                  "type": "number"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "todo",
                    "in-progress",
                    "review",
                    "done"
                  ]
                },
                "dueDate": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "progress",
                "status",
                "dueDate"
              ]
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "dueDate": {
                  "type": "string"
                },
                "priority": {
                  "type": "string",
                  "enum": [
                    "high",
                    "medium",
                    "low"
                  ]
                },
                "completed": {
                  "type": "boolean"
                },
                "projectId": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "dueDate",
                "priority",
                "completed",
                "projectId"
              ]
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ]
                },
                "title": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "startTime": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "date"
              ]
            }
          },
          "metrics": {
            "type": "object",
            "properties": {
              "totalProjects": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "totalProjects"
            ]
          },
          "sources": {
            "type": "object",
            "properties": {
              "projects": {
                "type": "string",
                "enum": [
                  "available",
                  "unavailable"
                ]
              },
              "tasks": {
                "type": "string",
                "enum": [
                  "available",
                  "unavailable"
                ]
              },
              "calendar": {
                "type": "string",
                "enum": [
                  "available",
                  "unavailable"
                ]
              }
            },
            "required": [
              "projects",
              "tasks",
              "calendar"
            ]
          }
        },
        "required": [
          "userFirstName",
          "projects",
          "tasks",
          "events",
          "metrics",
          "sources"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "tags": [
          "Connectivity"
        ],
        "summary": "Checks that the BFF process is up",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/check_apis": {
      "get": {
        "security": [],
        "tags": [
          "Connectivity"
        ],
        "summary": "Checks that the three upstream BFFs are reachable",
        "responses": {
          "200": {
            "description": "Every upstream BFF answered its /health operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckApisResponse"
                }
              }
            }
          },
          "502": {
            "description": "At least one upstream BFF is unreachable or not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckApisResponse"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/bootstrap": {
      "get": {
        "responses": {
          "200": {
            "description": "Data from the same BFFs as the business pages, within the session scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardBootstrap"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session, or session refused by an upstream BFF",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "User context unavailable: BFF User unreachable, failed or answered an invalid body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "An upstream BFF is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
