        {
          "name": "Bootstrap with a token signed with another secret is rejected",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_wrong_secret}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/bootstrap",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "bootstrap"
              ]
            },
            "description": "Well-formed token of the seeded agent signed with another secret: the BFF verifies the signature with Core's public key of this run (JWT_PUBLIC_KEY, MAIR-680) before any upstream call."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// An HS256 token { sub, role, exp } signed with a secret of no service (MAIR-680: Core signs EdDSA only).",
                  "const cryptoJs = require('crypto-js');",
                  "const b64url = (words) => cryptoJs.enc.Base64.stringify(words).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "const forge = (sub, secret) => {",
                  "    const header = b64url(cryptoJs.enc.Utf8.parse(JSON.stringify({ alg: 'HS256', typ: 'JWT' })));",
                  "    const payload = b64url(cryptoJs.enc.Utf8.parse(JSON.stringify({ sub, role: 'user', exp: Math.floor(Date.now() / 1000) + 3600 })));",
                  "    return `${header}.${payload}.${b64url(cryptoJs.HmacSHA256(`${header}.${payload}`, secret))}`;",
                  "};",
                  "pm.environment.set('jwt_wrong_secret', forge(pm.environment.get('agent_user_id'), 'not-the-secret-of-this-stack'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test(\"Body is the error envelope\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.error, 'error').to.be.an('object');",
                  "    pm.expect(body.error.code).to.be.a('string');",
                  "    pm.expect(body.error.message).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "MAIR-680 Bootstrap of the seeded administrator (EdDSA, Core's key)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_admin}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/bootstrap",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "bootstrap"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Answer is not cacheable\", function () {",
                  "    pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store');",
                  "});",
                  "pm.test(\"Bootstrap is the dashboard of the Admin, every source available\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.userFirstName).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.projects).to.be.an('array').with.lengthOf.at.most(6);",
                  "    pm.expect(body.tasks).to.be.an('array').with.lengthOf.at.most(8);",
                  "    pm.expect(body.events).to.be.an('array').with.lengthOf.at.most(6);",
                  "    // MAIR-825: ELearning API is not part of this stack, so only the three APIs it runs must be available.",
                  "    pm.expect({ projects: body.sources.projects, tasks: body.sources.tasks, calendar: body.sources.calendar }).to.eql({ projects: 'available', tasks: 'available', calendar: 'available' });",
                  "    pm.expect(body.sources.trainings).to.be.oneOf(['available', 'unavailable']);",
                  "    pm.expect(body.trainings).to.be.an('array').with.lengthOf.at.most(3);",
                  "    if (body.sources.trainings === 'unavailable') pm.expect(body.trainings).to.eql([]);",
                  "    // MAIR-1106: Message API is not part of this stack either: the badge is a count when it answers, null otherwise.",
                  "    pm.expect(body.sources.messages).to.be.oneOf(['available', 'unavailable']);",
                  "    if (body.sources.messages === 'unavailable') pm.expect(body.unreadMessages).to.eql(null);",
                  "    else pm.expect(body.unreadMessages).to.be.a('number').and.to.be.at.least(0);",
                  "    pm.expect(body.userLastName).to.be.a('string');",
                  "    pm.expect(body.userRole === null || typeof body.userRole === 'string', 'userRole is a string or null').to.eql(true);",
                  "    pm.expect(body.communeName === null || typeof body.communeName === 'string', 'communeName is a string or null').to.eql(true);",
                  "    pm.expect(body.metrics.totalProjects).to.be.a('number');",
                  "    pm.expect(body.metrics.totalProjects).to.be.at.least(body.projects.length);",
                  "    // The events indicator covers the current Europe/Paris calendar month.",
                  "    pm.expect(body.metrics.eventsThisMonth).to.be.a('number').and.to.be.at.least(0);",
                  "    pm.expect(body.metrics.eventsPeriod.from).to.match(/^\\d{4}-\\d{2}-01$/);",
                  "    pm.expect(body.metrics.eventsPeriod.to).to.match(/^\\d{4}-\\d{2}-(28|29|30|31)$/);",
                  "    pm.expect(body.metrics.eventsPeriod.to.slice(0, 7)).to.eql(body.metrics.eventsPeriod.from.slice(0, 7));",
                  "    body.projects.forEach((project) => {",
                  "        pm.expect(project.id).to.match(/^project-\\d+$/);",
                  "        pm.expect(project.status).to.be.oneOf(['todo', 'in-progress', 'review', 'done']);",
                  "        pm.expect(project.progress).to.be.within(0, 100);",
                  "    });",
                  "    body.tasks.forEach((task) => {",
                  "        pm.expect(task.id).to.match(/^task-\\d+$/);",
                  "        pm.expect(task.projectId).to.match(/^project-\\d+$/);",
                  "        pm.expect(task.priority).to.be.oneOf(['high', 'medium', 'low']);",
                  "        pm.expect(task.completed).to.eql(false);",
                  "    });",
                  "    body.events.forEach((event) => pm.expect(event.date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/));",
                  "    pm.expect(body.userFirstName, 'first name of the seeded Admin (liquibase keeps its own)').to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test(\"The token is an EdDSA token under Core's kid (MAIR-680)\", function () {",
                  "    const header = JSON.parse(atob(pm.environment.get('jwt_admin').split('.')[0].replace(/-/g, '+').replace(/_/g, '/')));",
                  "    pm.expect(header.alg).to.eql('EdDSA');",
                  "    pm.expect(header.kid).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
