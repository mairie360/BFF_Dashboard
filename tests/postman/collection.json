                  "    pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store');",
                  "});",
                  "pm.test(\"Bootstrap is the dashboard of the agent, every source available\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.userFirstName).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.projects).to.be.an('array').with.lengthOf.at.most(6);",
                  "    pm.expect(body.tasks).to.be.an('array').with.lengthOf.at.most(8);",
                  "    pm.expect(body.events).to.be.an('array').with.lengthOf.at.most(6);",
                  "    pm.expect(body.sources).to.eql({ projects: 'available', tasks: 'available', calendar: 'available' });",
                  "    pm.expect(body.metrics.totalProjects).to.be.a('number');",
                  "    pm.expect(body.metrics.totalProjects).to.be.at.least(body.projects.length);",
                  "    body.projects.forEach((project) => {",
                  "        pm.expect(project.id).to.match(/^project-\\d+$/);",
                  "        pm.expect(project.status).to.be.oneOf(['todo', 'in-progress', 'review', 'done']);",
                  "        pm.expect(project.progress).to.be.within(0, 100);",
                  "    });",
                  "    body.tasks.forEach((task) => {",
                  "        pm.expect(task.id).to.match(/^task-\\d+$/);",
                  "        pm.expect(task.projectId).to.match(/^project-\\d+$/);",
                  "        pm.expect(task.priority).to.be.oneOf(['high', 'medium', 'low']);",
                  "        pm.expect(task.completed).to.eql(false);",
                  "    });",
                  "    body.events.forEach((event) => pm.expect(event.date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/));",
                  "    pm.expect(body.userFirstName).to.eql('Perf');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "MAIR-680 The administrator's HS256 JWT cannot read the dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_hs256}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/bootstrap",
              "host": [
