    {
      "name": "MAIR-1177 Events of the month",
      "item": [
        {
          "name": "MAIR-1177 Bootstrap of the agent before the new event",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_agent}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/bootstrap",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "bootstrap"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 with the count of the month\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const metrics = pm.response.json().metrics;",
                  "    pm.expect(metrics.eventsThisMonth).to.be.a('number');",
                  "    pm.environment.set('events_month_before', metrics.eventsThisMonth);",
                  "    pm.environment.set('events_month_from', metrics.eventsPeriod.from);",
