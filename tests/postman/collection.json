            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// MAIR-680 business journey: what the administrator does next with Core's EdDSA token is refused to",
                  "// an HS256 token for the same administrator, whatever secret signed it.",
                  "pm.test(\"Status is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test(\"Error envelope, the token is not echoed\", function () {",
                  "    pm.expect(pm.response.json().error).to.be.an('object');",
                  "    pm.expect(pm.response.text()).to.not.include(pm.environment.get('jwt_hs256'));",
